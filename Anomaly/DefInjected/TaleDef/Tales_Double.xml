  <!-- EN: studied an entity -->
  <StudiedEntity.label>eine Entität studiert</StudiedEntity.label>
  <!-- EN:
    <li>tale_noun->[STUDIER_nameDef] studying [ENTITY_nameIndef]</li>
    <li>image->[STUDIER_nameFull] carefully examining [ENTITY_nameDef] [circumstance_group]</li>
    <li>image->[STUDIER_nameFull] conducting experiments, seeking to understand the secrets of [ENTITY_nameDef], [circumstance_group]</li>
    <li>image->[STUDIER_nameFull] striving to comprehend the nature of [ENTITY_nameDef] [circumstance_group]</li>
    <li>circumstance_phrase->with barely concealed disgust in [STUDIER_possessive] eyes</li>
    <li>circumstance_phrase->while scribbling in a notebook</li>
    <li>circumstance_phrase->while consulting an ancient tome</li>
    <li>desc_sentence->The steady work of bioferrite harvesters can be seen in the background.</li>
    <li>desc_sentence->The colonist's deep fascination with [ENTITY_nameDef] is evident.</li>
    <li>desc_sentence->[STUDIER_nameDef] is completely absorbed in [STUDIER_possessive] study of [ENTITY_nameDef], striving to unlock its secrets.</li>
    <li>desc_sentence->[ENTITY_nameDef] is only just held in the place by the ceaseless work of electro-inhibitors.</li>
    <li>desc_sentence->[ENTITY_nameDef] does not appear to react to [STUDIER_nameDef]'s efforts.</li>
  -->
  <StudiedEntity.rulePack.rulesStrings>
    <li>tale_noun->[STUDIER_nameDefNom] [ENTITY_nameDefAcc] studierte</li>
    <li>image->[STUDIER_nameFullIndefDat], wie [STUDIER_pronoun] [ENTITY_nameIndefAcc] vorsichtig untersucht, [circumstance_group]</li>
    <li>image->[STUDIER_nameFullIndefDat], wie [STUDIER_pronoun] Experimente an [ENTITY_nameIndefDat] durchführt, um [ENTITY_possessive]e Geheimnisse zu ergründen, [circumstance_group]</li>
    <li>image->[STUDIER_nameFullIndefDat], wie [STUDIER_pronoun] danach strebt, die Eigenschaften [ENTITY_nameIndefGen] zu begreifen, [circumstance_group]</li>
    <li>circumstance_phrase->mit kaum verhohlenem Abscheu in [STUDIER_possessive]en Augen</li>
    <li>circumstance_phrase->während [STUDIER_pronoun] in ein Notizbuch kritzelt</li>
    <li>circumstance_phrase->während [STUDIER_pronoun] einen alten Folianten zurate zieht</li>
    <li>desc_sentence->Im Hintergrund sind stetig laufende Bioferritkollektoren zu sehen.</li>
    <li>desc_sentence->Die tiefe Faszination des Kolonisten für [ENTITY_nameDefAcc] ist offensichtlich.</li>
    <li>desc_sentence->[STUDIER_nameDefNom] hat sich voll und ganz dem Studium [ENTITY_nameDefGen] gewidmet.</li>
    <li>desc_sentence->[ENTITY_nameDefNom] wird nur durch den unermüdlichen Einsatz der elektrischen Inhibitoren an Ort und Stelle gehalten.</li>
    <li>desc_sentence->[ENTITY_nameDefNom] scheint auf [STUDIER_label]'s Bemühungen nicht zu reagieren.</li>
    <li>STUDIER_nameDefNom->{lookup: [STUDIER_nameDef]; decline_tagged_nom}</li>
    <li>STUDIER_nameFullIndefDat->{lookup: [STUDIER_nameFull]; decline_tagged_dat}</li>
    <li>ENTITY_nameDefNom->{lookup: [ENTITY_nameDef]; decline_tagged_nom}</li>
    <li>ENTITY_nameDefGen->{lookup: von [ENTITY_nameDef]; decline_tagged_gen}</li>
    <li>ENTITY_nameDefAcc->{lookup: [ENTITY_nameDef]; decline_tagged_acc}</li>
    <li>ENTITY_nameIndefGen->{lookup: von [ENTITY_nameIndef]; decline_tagged_gen}</li>
    <li>ENTITY_nameIndefDat->{lookup: [ENTITY_nameIndef]; decline_tagged_dat}</li>
    <li>ENTITY_nameIndefAcc->{lookup: [ENTITY_nameIndef]; decline_tagged_acc}</li>
  </StudiedEntity.rulePack.rulesStrings>
  
