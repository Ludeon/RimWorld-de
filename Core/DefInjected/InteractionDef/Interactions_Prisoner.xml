    <li>toldastoryabout->told a funny story about</li>
    <li>toldastoryabout->told a heartfelt story about</li>
    <li>toldastoryabout->told an old story about</li>
    <li>toldastoryabout->told a family story about</li>
    <li>toldastoryabout->told a childhood story about</li>
    <li>toldastoryabout->mentioned an anecdote about</li>
    <li>talkabout->talk about</li>
    <li>talkabout->discuss</li>
    <li>talkabout->have a discussion about</li>
    <li>talkabout->ask about</li>
    <li>talkabout->think about</li>
    <li>talkabout->find common ground around</li>
    <li>subject->the colony</li>
    <li>subject->the community</li>
    <li>subject->joining the colony</li>
    <li>subject->changing teams</li>
    <li>subject->finding friends</li>
    <li>subject->meeting new people</li>
    <li>subject->reconsidering [RECIPIENT_possessive] ideas</li>
    <li>subject->rethinking [RECIPIENT_possessive] loyalties</li>
    <li>subject->health</li>
    <li>subject->the future</li>
    <li>subject->letting go</li>
    <li>subject(p=4)->[ConceptPositive]</li>
    <li>subject(p=2)->[INITIATOR_possessive] [PersonalCharacteristic]</li>
    <li>subject(p=8)->[TalkTopicLight]</li>
  -->
  <BuildRapport.logRulesInitiator.rulesStrings>
    <li>r_logentry->[INITIATOR_nameDefNom] erzählte [RECIPIENT_nameDefDat] [toldastoryabout] [subject].</li>
    <li>r_logentry->[INITIATOR_nameDefNom] ermunterte [RECIPIENT_nameDefAcc], [talkabout].</li>
    <li>r_logentry->[INITIATOR_nameDefNom] gab [RECIPIENT_nameDefDat] eine Chance, [talkabout].</li>
    <li>r_logentry->[INITIATOR_nameDefNom] zeigte Interesse an [RECIPIENT_label]'s [PersonalCharacteristicsDatDef].</li>
    <li>r_logentry(p=0.25)->[INITIATOR_nameDefNom] zeigte Interesse an den [PersonalCharacteristicsDatDef] von [RECIPIENT_nameDefDat].</li>
    <li>r_logentry(p=0.25)->[INITIATOR_nameDefNom] zeigte Interesse am [PersonalCharacteristicMasDatDef] von [RECIPIENT_nameDefDat].</li>
    <li>r_logentry(p=0.25)->[INITIATOR_nameDefNom] zeigte Interesse an der [PersonalCharacteristicFemDatDef] von [RECIPIENT_nameDefDat].</li>
    <li>r_logentry(p=0.25)->[INITIATOR_nameDefNom] zeigte Interesse am [PersonalCharacteristicNeuDatDef] von [RECIPIENT_nameDefDat].</li>
    <li>r_logentry(p=0.25)->[INITIATOR_nameDefNom] fragte [RECIPIENT_nameDefAcc] über [RECIPIENT_possessive]e [PersonalCharacteristicsAccDef] aus.</li>
    <li>r_logentry(p=0.25)->[INITIATOR_nameDefNom] fragte [RECIPIENT_nameDefAcc] über [RECIPIENT_possessive]en [PersonalCharacteristicMasAccDef] aus.</li>
    <li>r_logentry(p=0.25)->[INITIATOR_nameDefNom] fragte [RECIPIENT_nameDefAcc] über [RECIPIENT_possessive]e [PersonalCharacteristicFemAccDef] aus.</li>
    <li>r_logentry(p=0.25)->[INITIATOR_nameDefNom] fragte [RECIPIENT_nameDefAcc] über [RECIPIENT_possessive] [PersonalCharacteristicNeuAccDef] aus.</li>
    <li>toldastoryabout(p=4)->etwas über</li>
    <li>toldastoryabout(p=2)->eine Geschichte über</li>
    <li>toldastoryabout->eine witzige Geschichte über</li>
    <li>toldastoryabout->eine berührende Geschichte über</li>
    <li>toldastoryabout->eine alte Geschichte über</li>
    <li>toldastoryabout->eine Anekdote über</li>
    <li>talkabout->über [subject] zu reden</li>
    <li>talkabout->über [subject] zu diskutieren</li>
    <li>talkabout->Fragen über [subject] zu stellen</li>
    <li>talkabout->über [subject] nachzudenken</li>
    <li>talkabout->sich über [subject] auszusprechen</li>
    <li>subject->die Kolonie</li>
    <li>subject->die Gemeinschaft</li>
    <li>subject->den Beitritt in die Kolonie</li>
    <li>subject->den Alltag in der Kolonie</li>
    <li>subject->die Zukunft der Kolonie</li>
    <li>subject->das Treffen von neuen Leuten</li>
    <li>subject->das Kennenlernen neuer Freunde</li>
    <li>subject->das Loslassen alter Freundschaften</li>
    <li>subject(p=4)->[ConceptPositive]</li>
    <li>subject(p=0.5)->[INITIATOR_possessive]e [PersonalCharacteristicsAccDef]</li>
    <li>subject(p=0.5)->[INITIATOR_possessive]en [PersonalCharacteristicMasAccDef]</li>
    <li>subject(p=0.5)->[INITIATOR_possessive]e [PersonalCharacteristicFemAccDef]</li>
    <li>subject(p=0.5)->[INITIATOR_possessive] [PersonalCharacteristicNeuAccDef]</li>
    <li>subject(p=8)->[TalkTopicLightAcc]</li>
